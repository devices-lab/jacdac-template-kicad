    {
      "description": "Rename CPL columns for JLCPCB",
      "id": "1d7e8f4a-2c3b-4d6e-8f9a-b2c3d4e5f6a7",
      "settings": {
        "command": "python -c \"import os,sys,glob;p=r'${KIPRJMOD}';p=os.getcwd() if p[0]=='$' else p;g=os.path.join(p,'gerbers');c=glob.glob(os.path.join(g,'*CPL*.csv'));c or sys.exit('No CPL csv in '+g+' - did the export step fail?');f=c[0];h,b=open(f).read().split(chr(10),1);m={'Ref':'Designator','PosX':'Mid X','PosY':'Mid Y','Rot':'Rotation','Side':'Layer'};open(f,'w').write(','.join(m.get(c,c) for c in h.split(','))+chr(10)+b)\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "",
        "record_output": false
      },
      "type": "special_execute"
    },
    {
      "description": "Zip gerbers folder",
      "id": "2e8f9a5b-3d4c-4e7f-9a0b-c3d4e5f6a7b8",
      "settings": {
        "command": "python -c \"import os,shutil;p=r'${KIPRJMOD}';p=os.getcwd() if p[0]=='$' else p;g=os.path.join(p,'gerbers');shutil.make_archive(os.path.join(p,'gerbers-${PROJECTNAME}'),'zip',g)\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "",
        "record_output": false
      },
      "type": "special_execute"
    }
